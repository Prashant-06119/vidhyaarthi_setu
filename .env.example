# GEMINI_API_KEY: Required for Gemini AI API calls (not used by Vidyaarthi Setu offline engine).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPTIONAL SUPABASE CLOUD SYNC CONFIGURATION
# Vidyaarthi Setu works 100% offline without these credentials using IndexedDB and the Demo Sync Adapter.
# Provide real Supabase credentials to enable live PostgreSQL synchronization.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
